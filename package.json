{
  "name": "PWAscore",
  "private": true,
  "type": "module",
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "trailingComma": "none"
  },
  "lint-staged": {
    "*.{js,mjs,ts,vue}": [
      "eslint --fix"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "scripts": {
    "build": "node scripts/generate-og-screenshot.mjs && nuxt build",
    "dev": "nuxt dev",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "nuxt typecheck",
    "precommit": "pnpm run lint && pnpm run typecheck",
    "fix": "pnpm run lint:fix",
    "update-caniuse": "node scripts/download-caniuse.mjs",
    "generate-og": "node scripts/generate-og-screenshot.mjs",
    "deploy": "pnpm build && wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.104",
    "@iconify-json/simple-icons": "^1.2.80",
    "@nuxt/content": "^3.13.0",
    "@nuxt/image": "^2.0.0",
    "@nuxt/ui": "^4.7.0",
    "nuxt": "^4.4.2",
    "valibot": "^1.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260426.1",
    "@iconify-json/heroicons": "^1.2.3",
    "@mdn/browser-compat-data": "^7.3.13",
    "@nuxt/eslint": "^1.15.2",
    "@nuxt/test-utils": "^4.0.3",
    "@nuxtjs/i18n": "^10.3.0",
    "@vitest/ui": "^4.1.5",
    "@vue/test-utils": "^2.4.9",
    "eslint": "^10.2.1",
    "happy-dom": "^20.9.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "puppeteer-core": "^24.42.0",
    "sharp": "^0.34.5",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5",
    "vue-tsc": "^3.2.7",
    "wrangler": "^4.85.0"
  },
  "resolutions": {
    "unimport": "4.1.1"
  },
  "packageManager": "pnpm@10.33.2"
}
