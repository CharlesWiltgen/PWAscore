{
  "name": "PWAscore",
  "private": true,
  "type": "module",
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "trailingComma": "none"
  },
  "lint-staged": {
    "*.{js,mjs,ts,vue}": [
      "eslint --fix"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "scripts": {
    "build": "node scripts/generate-og-screenshot.mjs && nuxt build",
    "dev": "nuxt dev",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "eslint . --fix && prettier --write \"**/*.{json,md,yml,yaml}\"",
    "format:check": "eslint . && prettier --check \"**/*.{json,md,yml,yaml}\"",
    "typecheck": "nuxt typecheck",
    "precommit": "pnpm run lint && pnpm run typecheck",
    "fix": "pnpm run lint:fix",
    "update-caniuse": "node scripts/download-caniuse.mjs && pnpm run generate-score-history",
    "generate-score-history": "jiti scripts/generate-score-history.ts",
    "generate-og": "node scripts/generate-og-screenshot.mjs",
    "deploy": "pnpm build && wrangler deploy --old-asset-ttl 86400",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.157",
    "@iconify-json/simple-icons": "^1.2.103",
    "@nuxt/content": "^3.17.0",
    "@nuxt/image": "^2.2.1",
    "@nuxt/ui": "^4.13.0",
    "nuxt": "^4.6.4",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261120.1",
    "@iconify-json/heroicons": "^1.2.3",
    "@mdn/browser-compat-data": "8.1.10",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.4.0",
    "@nuxtjs/i18n": "^10.6.0",
    "@tiptap/y-tiptap": "^3.3.1",
    "@vitest/ui": "^5.1.1",
    "@vue/test-utils": "^2.6.0",
    "better-sqlite3": "^13.2.0",
    "eslint": "^10.15.0",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "lint-staged": "^17.6.1",
    "prettier": "^3.10.1",
    "puppeteer-core": "^25.18.1",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1",
    "vue-tsc": "3.3.11",
    "wrangler": "^4.166.0",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33"
  },
  "resolutions": {
    "unimport": "4.1.1"
  },
  "packageManager": "pnpm@10.33.2"
}
